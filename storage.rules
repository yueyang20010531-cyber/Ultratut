rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Content files - authenticated users can read shared content
    match /content/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to create files under their own content path
    match /content/{allPaths=**} {
      allow create: if request.auth != null;
    }

    // Submissions folder - students can upload their own submissions, teachers/admins can read all
    match /submissions/{assignmentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'] ||
         request.auth.uid == request.resource.data.studentId);
    }
  }
}
